any Bool = bool

Bool apple

if apple
else
    log("pass")

if not apple
    log("pass")

# pass
# pass

apple = false

log((bool)apple)

# 0

if apple
    log("pass2")

if not apple
else
    log("pass2")

# pass2
# pass2

apple = true

log((bool)apple)

# 1

if apple
    log("pass2")

if not apple
else
    log("pass2")

# pass2
# pass2